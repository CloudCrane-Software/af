+            os.replace(tmp, TRIGGER_ANDON_F)
+        except OSError as e:
+            log(f"安灯判据文件写失败 {type(e).__name__}: {str(e)[:80]}（不阻塞主循环）")
+    # 摘要行：跃迁必写；持续 amber 每 6h 刷新一次
