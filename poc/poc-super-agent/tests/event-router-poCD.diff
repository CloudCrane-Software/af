+            f"本轮消费腿跳过（fail-loud 不猜）")
+        return None
+    if reg.get("schema") != "af.trigger.registry.v1":
+        log(f"触发层注册表 schema 不识别: {str(reg.get('schema'))[:60]}，本轮消费腿跳过")
